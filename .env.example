# Copia este archivo a .env (ya está en .gitignore) y completa los valores reales.
# En GitHub Actions estas mismas variables se llaman igual, pero viven como Secrets del
# repo — nunca en un archivo. Ver CLAUDE.md sección "Secrets".

GEMINI_API_KEY=
FINNHUB_KEY=
SEC_USER_AGENT=
BCCH_API_KEY=
# Nunca la contraseña de Fintual acá ni en ningún lado del repo — el token se genera
# una vez a mano contra POST /api/access_tokens y se guarda solo esto.
FINTUAL_USER_EMAIL=
FINTUAL_USER_TOKEN=
